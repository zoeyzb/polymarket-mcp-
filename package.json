{
  "name": "zoey-polymarket-mcp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Polymarket intelligence MCP with multi-horizon scanning, historical replay, live dashboard, and non-custodial trade controls",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3",
    "ws": "^8.18.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0",
    "@types/ws": "^8.18.1",
    "@types/pg": "^8.15.5"
  }
}
